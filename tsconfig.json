{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "jsx": "react-native",
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["plugins", "types"]
}
